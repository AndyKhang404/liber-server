# Server
PORT=3000

# Authentication
# Secret key used for JWT token generation and verification (minimum 32 characters)
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min_32_bytes

# Database
# PostgreSQL connection string matching docker-compose.yml defaults
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_db

# Object Storage (MinIO / S3-compatible)
# MinIO defaults matching docker-compose.yml
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=liber-books
S3_REGION=us-east-1
